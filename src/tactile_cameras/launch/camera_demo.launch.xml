<?xml version="1.0"?>
<launch>
  <!-- Camera Publisher Node -->
  <node pkg="tactile_cameras" exec="camera_publisher.py" name="camera_publisher" output="screen">
    <param name="camera1_id" value="0"/>
    <param name="camera2_id" value="2"/>
    <param name="fps" value="30.0"/>
    <param name="width" value="640"/>
    <param name="height" value="480"/>
  </node>
  
  <!-- Camera Viewer Node -->
  <node pkg="tactile_cameras" exec="camera_viewer.py" name="camera_viewer" output="screen"/>
  
  <!-- Force Estimator Node -->
  <node pkg="tension_estimator" exec="force_estimator_node" name="feats_force_estimator" output="screen">
    <param name="camera1_topic" value="/gelsight_cam1/image_raw"/>
    <param name="camera2_topic" value="/gelsight_cam2/image_raw"/>
  </node>
</launch>
