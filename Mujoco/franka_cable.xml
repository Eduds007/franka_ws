<?xml version="1.0" encoding="utf-8"?>
<!--
  franka_cable.xml
  ================
  Cena MuJoCo: Franka Emika Panda (modelo oficial mujoco_menagerie)
  + cabo modelado como spatial tendon (tensão unilateral).

  Geometria:
    - Robô: base em (0,0,0)
    - Âncora (parede em X=0.85m): (0.8, 0, 0.4)
    - Cabo: comprimento máximo 0.5m (spatial tendon, limited)
    - Arco: raio 0.5m, plano XY, Z=0.4m, varredura de 120°

  Cabo (spatial tendon):
    - Conecta o site "end_effector" ao site "anchor_site"
    - limited="true" range="0 0.5" → tensão apenas quando len > 0.5m
    - Sem elos rígidos: nv=7 (apenas joints do robô)
    - A força do cabo aparece em data.qfrc_constraint[:7]

  Controle:
    - Atuadores: motor (torque direto) — compatível com controlador MultiPrioridade
    - P1: manter tensão ≈ 10N no cabo
    - P2: rastrear trajetória em arco no plano XY
-->
<mujoco model="franka_cable">

  <!-- Meshes do modelo oficial (mujoco_menagerie) via path absoluto -->
  <compiler angle="radian"
            meshdir="/home/eduardo/.cache/robot_descriptions/mujoco_menagerie/franka_emika_panda/assets"
            autolimits="true"/>

  <option timestep="0.002" integrator="implicitfast" impratio="10"
          gravity="0 0 -9.81" cone="elliptic"/>

  <!-- Defaults do Panda (inércia, materiais, geoms) -->
  <default>
    <default class="panda">
      <material specular="0.5" shininess="0.25"/>
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <default class="panda/visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="panda/collision">
        <geom type="mesh" group="3"/>
        <default class="panda/fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
        </default>
        <default class="panda/fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
        </default>
        <default class="panda/fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
        </default>
        <default class="panda/fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
        </default>
        <default class="panda/fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
        </default>
      </default>
      <default class="panda/finger">
        <joint axis="0 1 0" type="slide" range="0 0.04" armature="0.1" damping="1"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="1280" offheight="720" azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <!-- Materiais do Panda (do panda_nohand.xml) -->
    <material class="panda" name="white"      rgba="1 1 1 1"/>
    <material class="panda" name="off_white"  rgba="0.901961 0.921569 0.929412 1"/>
    <material class="panda" name="dark_grey"  rgba="0.25 0.25 0.25 1"/>
    <material class="panda" name="black"      rgba="0.25 0.25 0.25 1"/>
    <material class="panda" name="green"      rgba="0 1 0 1"/>
    <material class="panda" name="light_blue" rgba="0.039216 0.541176 0.780392 1"/>

    <!-- Materiais adicionais da cena -->
    <material name="anchor_mat"    rgba="0.20 0.40 0.80 1"/>
    <material name="floor_mat"     rgba="0.30 0.35 0.40 1"/>
    <material name="wall_mat"      rgba="0.70 0.70 0.70 0.8"/>
    <material name="connector_mat" rgba="0.8 0.3 0.1 1"/>

    <!-- Meshes de colisão do Panda -->
    <mesh name="link0_c"   file="link0.stl"/>
    <mesh name="link1_c"   file="link1.stl"/>
    <mesh name="link2_c"   file="link2.stl"/>
    <mesh name="link3_c"   file="link3.stl"/>
    <mesh name="link4_c"   file="link4.stl"/>
    <mesh name="link5_c0"  file="link5_collision_0.obj"/>
    <mesh name="link5_c1"  file="link5_collision_1.obj"/>
    <mesh name="link5_c2"  file="link5_collision_2.obj"/>
    <mesh name="link6_c"   file="link6.stl"/>
    <mesh name="link7_c"   file="link7.stl"/>

    <!-- Meshes visuais do Panda -->
    <mesh file="link0_0.obj"/>
    <mesh file="link0_1.obj"/>
    <mesh file="link0_2.obj"/>
    <mesh file="link0_3.obj"/>
    <mesh file="link0_4.obj"/>
    <mesh file="link0_5.obj"/>
    <mesh file="link0_7.obj"/>
    <mesh file="link0_8.obj"/>
    <mesh file="link0_9.obj"/>
    <mesh file="link0_10.obj"/>
    <mesh file="link0_11.obj"/>
    <mesh file="link1.obj"/>
    <mesh file="link2.obj"/>
    <mesh file="link3_0.obj"/>
    <mesh file="link3_1.obj"/>
    <mesh file="link3_2.obj"/>
    <mesh file="link3_3.obj"/>
    <mesh file="link4_0.obj"/>
    <mesh file="link4_1.obj"/>
    <mesh file="link4_2.obj"/>
    <mesh file="link4_3.obj"/>
    <mesh file="link5_0.obj"/>
    <mesh file="link5_1.obj"/>
    <mesh file="link5_2.obj"/>
    <mesh file="link6_0.obj"/>
    <mesh file="link6_1.obj"/>
    <mesh file="link6_2.obj"/>
    <mesh file="link6_3.obj"/>
    <mesh file="link6_4.obj"/>
    <mesh file="link6_5.obj"/>
    <mesh file="link6_6.obj"/>
    <mesh file="link6_7.obj"/>
    <mesh file="link6_8.obj"/>
    <mesh file="link6_9.obj"/>
    <mesh file="link6_10.obj"/>
    <mesh file="link6_11.obj"/>
    <mesh file="link6_12.obj"/>
    <mesh file="link6_13.obj"/>
    <mesh file="link6_14.obj"/>
    <mesh file="link6_15.obj"/>
    <mesh file="link6_16.obj"/>
    <mesh file="link7_0.obj"/>
    <mesh file="link7_1.obj"/>
    <mesh file="link7_2.obj"/>
    <mesh file="link7_3.obj"/>
    <mesh file="link7_4.obj"/>
    <mesh file="link7_5.obj"/>
    <mesh file="link7_6.obj"/>
    <mesh file="link7_7.obj"/>

    <!-- Meshes da Franka Hand -->
    <mesh name="hand_c"  file="hand.stl"/>
    <mesh file="hand_0.obj"/>
    <mesh file="hand_1.obj"/>
    <mesh file="hand_2.obj"/>
    <mesh file="hand_3.obj"/>
    <mesh file="hand_4.obj"/>
    <mesh file="finger_0.obj"/>
    <mesh file="finger_1.obj"/>
  </asset>

  <worldbody>

    <!-- Iluminação e chão -->
    <light name="top" pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.05"
          material="floor_mat" contype="1" conaffinity="1"/>

    <!-- Parede visual onde o cabo está fixado (X=0.85m) -->
    <geom name="wall" type="box" pos="0.88 0 0.75" size="0.03 0.6 0.75"
          material="wall_mat" contype="0" conaffinity="0"/>

    <!-- ================================================================
         FRANKA EMIKA PANDA — geometria e inércia oficiais (mujoco_menagerie)
         Base fixa no chão em (0, 0, 0)
         nv = 7 (apenas joints do robô, sem elos de cabo)
         ================================================================ -->
    <body name="link0" childclass="panda">
      <inertial mass="0.629769" pos="-0.041018 -0.00014 0.049974"
        fullinertia="0.00315 0.00388 0.004285 8.2904e-7 0.00015 8.2299e-6"/>
      <geom mesh="link0_0"  material="off_white" class="panda/visual"/>
      <geom mesh="link0_1"  material="dark_grey" class="panda/visual"/>
      <geom mesh="link0_2"  material="off_white" class="panda/visual"/>
      <geom mesh="link0_3"  material="dark_grey" class="panda/visual"/>
      <geom mesh="link0_4"  material="off_white" class="panda/visual"/>
      <geom mesh="link0_5"  material="dark_grey" class="panda/visual"/>
      <geom mesh="link0_7"  material="white"     class="panda/visual"/>
      <geom mesh="link0_8"  material="white"     class="panda/visual"/>
      <geom mesh="link0_9"  material="dark_grey" class="panda/visual"/>
      <geom mesh="link0_10" material="off_white" class="panda/visual"/>
      <geom mesh="link0_11" material="white"     class="panda/visual"/>
      <geom mesh="link0_c"  class="panda/collision"/>

      <body name="link1" pos="0 0 0.333">
        <inertial mass="4.970684" pos="0.003875 0.002081 -0.04762"
          fullinertia="0.70337 0.70661 0.0091170 -0.00013900 0.0067720 0.019169"/>
        <joint name="joint1"/>
        <geom material="white" mesh="link1"   class="panda/visual"/>
        <geom mesh="link1_c"                  class="panda/collision"/>

        <body name="link2" quat="1 -1 0 0">
          <inertial mass="0.646926" pos="-0.003141 -0.02872 0.003495"
            fullinertia="0.0079620 2.8110e-2 2.5995e-2 -3.925e-3 1.0254e-2 7.04e-4"/>
          <joint name="joint2" range="-1.7628 1.7628"/>
          <geom material="white" mesh="link2" class="panda/visual"/>
          <geom mesh="link2_c"                class="panda/collision"/>

          <body name="link3" pos="0 -0.316 0" quat="1 1 0 0">
            <joint name="joint3"/>
            <inertial mass="3.228604" pos="2.7518e-2 3.9252e-2 -6.6502e-2"
              fullinertia="3.7242e-2 3.6155e-2 1.083e-2 -4.761e-3 -1.1396e-2 -1.2805e-2"/>
            <geom mesh="link3_0" material="white"     class="panda/visual"/>
            <geom mesh="link3_1" material="white"     class="panda/visual"/>
            <geom mesh="link3_2" material="white"     class="panda/visual"/>
            <geom mesh="link3_3" material="dark_grey" class="panda/visual"/>
            <geom mesh="link3_c"                      class="panda/collision"/>

            <body name="link4" pos="0.0825 0 0" quat="1 1 0 0">
              <inertial mass="3.587895" pos="-5.317e-2 1.04419e-1 2.7454e-2"
                fullinertia="2.5853e-2 1.9552e-2 2.8323e-2 7.796e-3 -1.332e-3 8.641e-3"/>
              <joint name="joint4" range="-3.0718 -0.0698"/>
              <geom mesh="link4_0" material="white"     class="panda/visual"/>
              <geom mesh="link4_1" material="white"     class="panda/visual"/>
              <geom mesh="link4_2" material="dark_grey" class="panda/visual"/>
              <geom mesh="link4_3" material="white"     class="panda/visual"/>
              <geom mesh="link4_c"                      class="panda/collision"/>

              <body name="link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                <inertial mass="1.225946" pos="-1.1953e-2 4.1065e-2 -3.8437e-2"
                  fullinertia="3.5549e-2 2.9474e-2 8.627e-3 -2.117e-3 -4.037e-3 2.29e-4"/>
                <joint name="joint5"/>
                <geom mesh="link5_0" material="dark_grey" class="panda/visual"/>
                <geom mesh="link5_1" material="white"     class="panda/visual"/>
                <geom mesh="link5_2" material="white"     class="panda/visual"/>
                <geom mesh="link5_c0" class="panda/collision"/>
                <geom mesh="link5_c1" class="panda/collision"/>
                <geom mesh="link5_c2" class="panda/collision"/>

                <body name="link6" quat="1 1 0 0">
                  <inertial mass="1.666555" pos="6.0149e-2 -1.4117e-2 -1.0517e-2"
                    fullinertia="1.964e-3 4.354e-3 5.433e-3 1.09e-4 -1.158e-3 3.41e-4"/>
                  <joint name="joint6" range="-0.0175 3.7525"/>
                  <geom mesh="link6_0"  material="off_white"  class="panda/visual"/>
                  <geom mesh="link6_1"  material="white"      class="panda/visual"/>
                  <geom mesh="link6_2"  material="dark_grey"  class="panda/visual"/>
                  <geom mesh="link6_3"  material="white"      class="panda/visual"/>
                  <geom mesh="link6_4"  material="white"      class="panda/visual"/>
                  <geom mesh="link6_5"  material="white"      class="panda/visual"/>
                  <geom mesh="link6_6"  material="white"      class="panda/visual"/>
                  <geom mesh="link6_7"  material="light_blue" class="panda/visual"/>
                  <geom mesh="link6_8"  material="light_blue" class="panda/visual"/>
                  <geom mesh="link6_9"  material="dark_grey"  class="panda/visual"/>
                  <geom mesh="link6_10" material="dark_grey"  class="panda/visual"/>
                  <geom mesh="link6_11" material="white"      class="panda/visual"/>
                  <geom mesh="link6_12" material="green"      class="panda/visual"/>
                  <geom mesh="link6_13" material="white"      class="panda/visual"/>
                  <geom mesh="link6_14" material="dark_grey"  class="panda/visual"/>
                  <geom mesh="link6_15" material="dark_grey"  class="panda/visual"/>
                  <geom mesh="link6_16" material="white"      class="panda/visual"/>
                  <geom mesh="link6_c"  class="panda/collision"/>

                  <body name="link7" pos="0.088 0 0" quat="1 1 0 0">
                    <inertial mass="7.35522e-01" pos="1.0517e-2 -4.252e-3 6.1597e-2"
                      fullinertia="1.2516e-2 1.0027e-2 4.815e-3 -4.28e-4 -1.196e-3 -7.41e-4"/>
                    <joint name="joint7"/>
                    <geom mesh="link7_0" material="white"     class="panda/visual"/>
                    <geom mesh="link7_1" material="dark_grey" class="panda/visual"/>
                    <geom mesh="link7_2" material="dark_grey" class="panda/visual"/>
                    <geom mesh="link7_3" material="dark_grey" class="panda/visual"/>
                    <geom mesh="link7_4" material="dark_grey" class="panda/visual"/>
                    <geom mesh="link7_5" material="dark_grey" class="panda/visual"/>
                    <geom mesh="link7_6" material="dark_grey" class="panda/visual"/>
                    <geom mesh="link7_7" material="white"     class="panda/visual"/>
                    <geom mesh="link7_c" class="panda/collision"/>

                    <!-- Franka Hand (garra paralela) -->
                    <body name="hand" pos="0 0 0.107" quat="0.9238795 0 0 -0.3826834" childclass="panda">
                      <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
                      <geom mesh="hand_0" material="off_white" class="panda/visual"/>
                      <geom mesh="hand_1" material="black"     class="panda/visual"/>
                      <geom mesh="hand_2" material="black"     class="panda/visual"/>
                      <geom mesh="hand_3" material="white"     class="panda/visual"/>
                      <geom mesh="hand_4" material="off_white" class="panda/visual"/>
                      <geom mesh="hand_c" class="panda/collision"/>
                      <!-- TCP: ponto entre as pontas dos dedos — referência do controlador -->
                      <site name="end_effector" pos="0 0 0.112" size="0.02"
                            rgba="1 0 0 1" group="1"/>
                      <body name="left_finger" pos="0 0 0.0584">
                        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                        <joint name="finger_joint1" class="panda/finger"/>
                        <geom mesh="finger_0" material="off_white" class="panda/visual"/>
                        <geom mesh="finger_1" material="black"     class="panda/visual"/>
                        <geom mesh="finger_0" class="panda/collision"/>
                        <geom class="panda/fingertip_pad_collision_1"/>
                        <geom class="panda/fingertip_pad_collision_2"/>
                        <geom class="panda/fingertip_pad_collision_3"/>
                        <geom class="panda/fingertip_pad_collision_4"/>
                        <geom class="panda/fingertip_pad_collision_5"/>
                      </body>
                      <body name="right_finger" pos="0 0 0.0584" quat="0 0 0 1">
                        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                        <joint name="finger_joint2" class="panda/finger"/>
                        <geom mesh="finger_0" material="off_white" class="panda/visual"/>
                        <geom mesh="finger_1" material="black"     class="panda/visual"/>
                        <geom mesh="finger_0" class="panda/collision"/>
                        <geom class="panda/fingertip_pad_collision_1"/>
                        <geom class="panda/fingertip_pad_collision_2"/>
                        <geom class="panda/fingertip_pad_collision_3"/>
                        <geom class="panda/fingertip_pad_collision_4"/>
                        <geom class="panda/fingertip_pad_collision_5"/>
                      </body>
                    </body>

                  </body> <!-- link7 -->
                </body> <!-- link6 -->
              </body> <!-- link5 -->
            </body> <!-- link4 -->
          </body> <!-- link3 -->
        </body> <!-- link2 -->
      </body> <!-- link1 -->
    </body> <!-- link0 -->

    <!-- ================================================================
         CONECTOR DO CABO — corpo rígido no chão (0.5, 0, 0.025)
         O robô deve pegar este conector antes de executar o arco.
         O cabo (spatial tendon) conecta cable_connector_site a anchor_site.
         ================================================================ -->
    <body name="cable_connector" pos="0.5 0.0 0.025">
      <freejoint name="cable_connector_joint"/>
      <inertial mass="0.05" pos="0 0 0" diaginertia="1e-4 1e-4 5e-5"/>
      <geom name="connector_geom" type="cylinder" size="0.012 0.025"
            material="connector_mat" contype="1" conaffinity="1"/>
      <site name="cable_connector_site" pos="0 0 0.025" size="0.015"
            rgba="0.9 0.6 0.1 1" group="1"/>
    </body>

    <!-- ================================================================
         ÂNCORA — ponto fixo na parede (X=0.8m, Y=0, Z=0.4m)
         ================================================================ -->
    <body name="anchor" pos="0.8 0 0.4">
      <geom type="sphere" size="0.025" material="anchor_mat"
            contype="1" conaffinity="1"/>
      <site name="anchor_site" pos="0 0 0" size="0.02"
            rgba="0.2 0.4 0.8 1" group="1"/>
    </body>

    <!-- Marcador visual do alvo (mocap body — atualizado em runtime) -->
    <body name="target_marker" mocap="true" pos="0.3 0 0.4">
      <geom type="sphere" size="0.025" rgba="0.1 0.9 0.1 0.6"
            contype="0" conaffinity="0"/>
    </body>

  </worldbody>

  <!-- ================================================================
       CABO — spatial tendon (tensão unilateral)

       Conecta o site "end_effector" ao site "anchor_site".
       limited="true" range="0 0.5":
         - Quando dist(EE, âncora) ≤ 0.5m: nenhuma força (cabo frouxo)
         - Quando dist(EE, âncora) > 0.5m: constraint puxa EE em direção à âncora

       Física correta de cabo:
         - Força unilateral (só tração, nunca compressão)
         - Tensão lida de data.qfrc_constraint[:7] projetada em J1
         - Renderizado como linha laranja no viewer
  ================================================================ -->
  <tendon>
    <!-- Cabo: do conector (corpo livre) até a âncora na parede -->
    <spatial name="cable" limited="true" range="0 0.5"
             width="0.006" rgba="0.9 0.6 0.1 1"
             damping="5"
             solreflimit="0.01 1" solimplimit="0.95 0.99 0.001 0.5 2">
      <site site="cable_connector_site"/>
      <site site="anchor_site"/>
    </spatial>
    <!-- Dedos acoplados: ambos se movem simetricamente -->
    <fixed name="split">
      <joint joint="finger_joint1" coef="0.5"/>
      <joint joint="finger_joint2" coef="0.5"/>
    </fixed>
  </tendon>

  <!-- Simetria dos dedos + weld de grasp (inativo no início) -->
  <equality>
    <joint name="finger_symmetry"
           joint1="finger_joint1" joint2="finger_joint2"
           solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <weld name="grasp_weld"
          body1="hand" body2="cable_connector"
          relpose="0 0 0.112 1 0 0 0"
          solimp="0.95 0.99 0.001" solref="0.005 1"
          active="false"/>
  </equality>

  <!-- ================================================================
       ATUADORES — controle de torque direto (motor)
       Compatível com o controlador MultiPrioridade (null-space projection)
       Limites de torque do Panda:
         joints 1-4: ±87 N·m
         joints 5-7: ±12 N·m
       ================================================================ -->
  <actuator>
    <motor name="act1" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-87  87"/>
    <motor name="act2" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-87  87"/>
    <motor name="act3" joint="joint3" gear="1" ctrllimited="true" ctrlrange="-87  87"/>
    <motor name="act4" joint="joint4" gear="1" ctrllimited="true" ctrlrange="-87  87"/>
    <motor name="act5" joint="joint5" gear="1" ctrllimited="true" ctrlrange="-12  12"/>
    <motor name="act6" joint="joint6" gear="1" ctrllimited="true" ctrlrange="-12  12"/>
    <motor name="act7" joint="joint7" gear="1" ctrllimited="true" ctrlrange="-12  12"/>
    <!-- Garra: ctrl=255→aberto (0.04m), ctrl=0→fechado -->
    <general name="act_gripper" tendon="split" forcerange="-100 100" ctrlrange="0 255"
             gainprm="0.01568627451 0 0" biasprm="0 -100 -10"/>
  </actuator>

  <!-- ================================================================
       SENSORES — posições dos pontos de referência
       ================================================================ -->
  <sensor>
    <framepos name="ee_pos"     objtype="site" objname="end_effector"/>
    <framepos name="anchor_pos" objtype="site" objname="anchor_site"/>
  </sensor>

  <contact>
    <exclude body1="link0"          body2="link1"/>
    <exclude body1="hand"           body2="left_finger"/>
    <exclude body1="hand"           body2="right_finger"/>
    <exclude body1="cable_connector" body2="left_finger"/>
    <exclude body1="cable_connector" body2="right_finger"/>
  </contact>

  <!-- Posição inicial: robô em "home", dedos abertos, conector no chão -->
  <!-- qpos: 7 joints braço + 2 joints dedos + 7 DOFs do free joint do conector -->
  <keyframe>
    <key name="home"
         qpos="0 0 0 -1.57079 0 1.57079 -0.78540 0.04 0.04
               0.5 0.0 0.025 1 0 0 0"
         ctrl="0 0 0 0 0 0 0 255"/>
  </keyframe>

</mujoco>
